    {
      "cell_type": "code",
      "execution_count": 136,
      "id": "ee40f915",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-09-16T17:42:04.326279Z",
          "iopub.status.busy": "2026-09-16T17:42:04.326073Z",
          "iopub.status.idle": "2026-09-16T17:42:04.329713Z",
