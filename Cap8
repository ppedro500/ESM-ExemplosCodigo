          "shell.execute_reply": "2026-09-16T17:42:02.013677Z"
        },
        "id": "5422077e"
      },
      "outputs": [],
      "source": [
        "def make_sample_with_errors(n):\n",
        "    sample = np.random.normal(mu, sigma, size=n)\n",
        "    factor = np.random.choice([1, 2.2], p=[0.98, 0.02], size=n)\n",
        "    return sample * factor"
      ]
