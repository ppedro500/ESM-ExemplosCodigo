        "outputId": "2e00b393-b3c2-4d0e-8516-dd32f2f3dfb3"
      },
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "0.3814986213564681"
            ]
          },
          "metadata": {},
          "execution_count": 135
        }
      ],
      "source": [
        "np.std(weights)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "2622656c",
      "metadata": {
        "id": "2622656c"
      },
      "source": [
        "The standard error of the average weight is about 0.046 kg."
