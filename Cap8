      },
      "outputs": [],
      "source": [
        "def unbiased_var(xs):\n",
        "    # Compute variance with n-1 in the denominator\n",
        "    n = len(xs)\n",
        "    deviations = xs - np.mean(xs)\n",
        "    return np.sum(deviations**2) / (n - 1)"
